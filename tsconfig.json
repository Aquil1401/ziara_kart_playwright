{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "pages/**/*.ts",
    "locators/**/*.ts",
    "tests/**/*.ts",
    "testdata/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts"
  ]
}
